###### Typecheck ######
--packager-layers must contain items that are alphanumeric.

###### Running gen-packages ######
--packager-layers must contain items that are alphanumeric.

###### cat ./app_service/__package.rb ######
# typed: strict

class AppService < PackageSpec
  layer 'app_service'
  strict_dependencies 'layered'
end

###### cat ./base_lib/__package.rb ######
# typed: strict

class BaseLib < PackageSpec
  layer 'base_lib'
  strict_dependencies 'layered'

  import AppService
end

###### cat ./test/helper/__package.rb ######
# typed: strict

class Test::Helper < PackageSpec
  test!
  layer 'test_helper'
  strict_dependencies 'false'

  import AppService
  import Test::Infra
end

###### cat ./test/infra/__package.rb ######
# typed: strict

class Test::Infra < PackageSpec
  test!
  layer 'test_infra'
  strict_dependencies 'false'

  import BaseLib
  import Test::Unit
end

###### cat ./test/unit/__package.rb ######
# typed: strict

class Test::Unit < PackageSpec
  test!
  layer 'test_unit'
  strict_dependencies 'false'

  import Test::Helper
end
