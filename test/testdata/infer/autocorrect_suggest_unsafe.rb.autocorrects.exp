# -- test/testdata/infer/autocorrect_suggest_unsafe.rb --
# typed: true
# enable-suggest-unsafe: true
extend T::Sig

sig {returns(String)}
def wrap_in_unsafe
  T.unsafe(nil) # error: Expected `String` but found `NilClass` for method result type
end

class DSLMethod
  extend T::Sig

  # The method that `attr_writer` defines uses the whole `attr_writer :foo`
  # as the loc of its return value. There's no expression to wrap.
  sig {params(foo: Integer).returns(String)}
  attr_writer :foo # error: Expected `String` but found `Integer` for method result type
end

sig {params(c: T::Boolean, u: T.untyped).returns(String)}
def branches(c, u)
  T.unsafe(if c
    0 # error: Expected `String` but found `Integer(0)` for method result type
  else
    u
  end)
end

sig {params(c: T::Boolean, u: T.untyped).returns(String)}
def missing_else(c, u)
  T.unsafe(if c
    u
  end) # error: Expected `String` but found `NilClass` for method result type
end

sig {params(x: T.untyped).returns(String)}
def safe_navigation(x)
  T.unsafe(x&.foo) # error: Expected `String` but found `NilClass` for method result type
end

sig {params(u: T.untyped).returns(T::Boolean)}
def and_and(u)
  T.unsafe(u.foo? && u.bar?) # error: Expected `T::Boolean` but found `T.nilable(FalseClass)` for method result type
end

sig {params(x: Integer, u: T.untyped).returns(String)}
def elsif_missing_else(x, u)
  T.unsafe(if x == 1
    u
  elsif x == 2
    u
  end) # error: Expected `String` but found `NilClass` for method result type
end

sig {params(x: T.any(Integer, String, Symbol), u: T.untyped).returns(String)}
def case_missing_else(x, u)
  T.unsafe(case x
  when Integer then u
  when String then u
  end) # error: Expected `String` but found `NilClass` for method result type
end

sig {params(u: T.untyped).returns(T::Boolean)}
def and_and_block(u)
  T.unsafe(u.all? { |k| k.foo } && u.bar) # error: Expected `T::Boolean` but found `T.nilable(FalseClass)` for method result type
end

sig {returns(Integer)}
def or_assign_ivar
  T.unsafe(@or_assign_ivar ||= 'str') # error: Expected `Integer` but found `String("str")` for method result type
end

sig {params(h: T::Hash[T.untyped, Integer], k: T.untyped).returns(String)}
def or_assign_index(h, k)
  T.unsafe(h[k] ||= 0)
# ^^^^ error: Expected `String` but found `Integer` for method result type
# ^^^^ error: Expected `String` but found `Integer(0)` for method result type
end

module ConstantBranch
  X = T.let('', String)
end

sig {params(c: T::Boolean, u: T.untyped).returns(Integer)}
def constant_branch(c, u)
  T.unsafe(if c
    ConstantBranch::X # error: Expected `Integer` but found `String` for method result type
  else
    u
  end)
end

sig {params(c: T::Boolean, u: T.untyped).returns(String)}
def modifier_if_missing_else(c, u)
  T.unsafe(u if c) # error: Expected `String` but found `NilClass` for method result type
end

sig {params(c: T::Boolean, u: T.untyped).returns(Integer)}
def block_branch(c, u)
  T.unsafe(if c
    [1].map { |x| x.to_s } # error: Expected `Integer` but found `T::Array[String]` for method result type
  else
    u
  end)
end

sig {params(c: T::Boolean, u: T.untyped).returns(Integer)}
def block_receiver_branch(c, u)
  T.unsafe(if c
    [1].to_h { |g| [g, g] }.reject { |k, _| k.nil? } # error: Expected `Integer` but found `T::Hash[Integer, Integer]` for method result type
  else
    u
  end)
end
