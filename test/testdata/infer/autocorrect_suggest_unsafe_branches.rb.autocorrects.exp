    u
  elsif x == 2
    T.unsafe(0) # error: Expected `String` but found `Integer(0)` for method result type
  else
    u
  end
end

sig {params(x: Symbol, u: T.untyped).returns(String)}
def when_branch(x, u)
  case x
  when :a then T.unsafe(0) # error: Expected `String` but found `Integer(0)` for method result type
