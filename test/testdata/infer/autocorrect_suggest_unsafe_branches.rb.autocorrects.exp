sig {params(c: T::Boolean, d: T::Boolean, u: T.untyped).returns(String)}
def nested_if(c, d, u)
  if c
    if d then T.unsafe(0) else u end # error: Expected `String` but found `Integer(0)` for method result type
  else
    T.unsafe(:sym) # error: Expected `String` but found `Symbol(:sym)` for method result type
  end
end

sig {params(t: Symbol, x: T.nilable(String)).returns(String)}
def nested_modifier_if(t, x)
  case t
  when :a
    x if x # error: Expected `String` but found `NilClass` for method result type
  else
    T.unsafe(t) # error: Expected `String` but found `Symbol` for method result type
  end
end

sig {params(t: Symbol, c: T::Boolean, u: T.untyped).returns(String)}
def nested_in_missing_else(t, c, u)
  case t
  when :a
    if c then T.unsafe(0) else u end # error: Expected `String` but found `Integer(0)` for method result type
  else
    T.unsafe(nil)
  end # error: Expected `String` but found `NilClass` for method result type
end

sig {params(x: T.untyped).returns(String)}
