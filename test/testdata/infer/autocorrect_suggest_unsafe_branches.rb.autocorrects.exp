# typed: true
# enable-suggest-unsafe: true
extend T::Sig

sig {params(c: T::Boolean, x: T.untyped).returns(Integer)}
def multi_line(c, x)
  if c
    x
  else
    T.unsafe("not an integer") # error: Expected `Integer` but found `String("not an integer")` for method result type
  end
end

sig {params(c: T::Boolean, u: T.untyped).returns(String)}
def multi_statement(c, u)
  if c
    puts
    T.unsafe(0) # error: Expected `String` but found `Integer(0)` for method result type
  else
    u
  end
end

sig {params(c: T::Boolean, u: T.untyped).returns(String)}
def parenthesized(c, u)
  if c then (puts; T.unsafe(0)) else u end # error: Expected `String` but found `Integer(0)` for method result type
end

sig {params(c: T::Boolean, u: T.untyped).returns(String)}
def ternary(c, u)
  c ? T.unsafe(0) : u # error: Expected `String` but found `Integer(0)` for method result type
end

sig {params(c: T::Boolean, u: T.untyped).returns(String)}
def unless_else(c, u)
  unless c then T.unsafe(0) else u end # error: Expected `String` but found `Integer(0)` for method result type
end

