# typed: strict
# spacer for exclude-from-file-update
# Changed on purpose: an update identical to the file's contents does not count as a changed file.

module Root
  class Main
    T.reveal_type(Lib::MyStaticField) # error: `Integer`

    T.reveal_type(Lib::MyPrivateStaticField)
    #             ^^^^^^^^^^^^^^^^^^^^^^^^^ error: resolves but is not exported
  # ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ error: `Integer`
  end
end
