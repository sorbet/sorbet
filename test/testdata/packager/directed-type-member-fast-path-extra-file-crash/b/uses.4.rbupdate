# typed: strict
# frozen_string_literal: true
# assert-slow-path: true

class B::Uses
  extend T::Sig

  sig { returns(A::Gen[Integer, Integer, Integer, Integer]) }
  def self.gen = raise

  sig { returns(Integer) }
  def self.other = 0

  sig { returns(Integer) }
  def self.other2 = 0
end

class B::NewClass; end

# Like version 2: a new class forces this edit to take the slow path, which will
# copy the symbol table prefix at the (too high) stratum recorded by version 3,
# dropping the type members that version 3's fast path re-entered at the end of
# the symbol table.
class B::NewClass2; end
